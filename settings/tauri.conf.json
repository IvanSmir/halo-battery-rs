{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Halo Battery",
  "version": "0.1.0",
  "identifier": "dev.halobattery.settings",
  "mainBinaryName": "halo-settings",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Halo Battery",
        "width": 1120,
        "height": 760,
        "minWidth": 980,
        "minHeight": 620,
        "center": true,
        "decorations": false,
        "transparent": true,
        "windowEffects": { "effects": ["mica"] }
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.ico"]
  }
}
